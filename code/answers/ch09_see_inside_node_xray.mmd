graph TD;
	__start__([<p>__start__</p>]):::first
	agent(agent)
	generate(generate)
	__end__([<p>__end__</p>]):::last
	__start__ --> agent;
	agent --> rag\3arewrite;
	rag\3arerank --> generate;
	generate --> __end__;
