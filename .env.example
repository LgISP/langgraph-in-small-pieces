# Copy to .env and fill in. See Chapter 22, "LangSmith: the tracer you don't write".
#
# With these set, LangChain's callback manager attaches a LangChainTracer to every
# run on its own -- no import, no decorator, no change to the graph. Every node, and
# every model / tool / retriever call inside a node, is streamed to LangSmith.

# Turn tracing on. Newer name; LANGCHAIN_TRACING_V2=true is the older equivalent.
LANGSMITH_TRACING=true

# Your key from https://smith.langchain.com  (Settings -> API Keys).
LANGSMITH_API_KEY=lsv2_pt_replace_me

# Optional: the project runs are grouped under (defaults to "default").
LANGSMITH_PROJECT=doc-bot

# Self-hosted LangSmith only (Enterprise): point at your own instance instead of the
# cloud. Leave unset to use smith.langchain.com.
# LANGSMITH_ENDPOINT=https://langsmith.your-company.internal
